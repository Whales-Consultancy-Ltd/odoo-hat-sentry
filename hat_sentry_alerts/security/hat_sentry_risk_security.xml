<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company rules -->
    <record id="rule_hat_sentry_risk_limit_company" model="ir.rule">
        <field name="name">hat_sentry.risk.limit: multi-company isolation</field>
        <field name="model_id" ref="model_hat_sentry_risk_limit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rule_hat_sentry_risk_event_company" model="ir.rule">
        <field name="name">hat_sentry.risk.event: multi-company isolation</field>
        <field name="model_id" ref="model_hat_sentry_risk_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rule_hat_sentry_cooldown_company" model="ir.rule">
        <field name="name">hat_sentry.cooldown: multi-company isolation</field>
        <field name="model_id" ref="model_hat_sentry_cooldown"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <!-- Trader can acknowledge own risk events -->
    <record id="rule_hat_sentry_risk_event_trader_ack" model="ir.rule">
        <field name="name">hat_sentry.risk.event: trader can acknowledge own</field>
        <field name="model_id" ref="model_hat_sentry_risk_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hat_sentry.group_hat_sentry_trader'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
