<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_collect_snapshot" model="ir.cron">
        <field name="name">Hat Sentry: Collect Binance Data</field>
        <field name="model_id" ref="model_hat_sentry_binance_collector"/>
        <field name="state">code</field>
        <field name="code">model.cron_collect_snapshot()</field>
        <field name="interval_number">60</field>
        <field name="interval_type">minutes</field>

        <field name="active" eval="False"/>

    </record>

    <record id="cron_collect_funding" model="ir.cron">
        <field name="name">Hat Sentry: Collect Funding Events</field>
        <field name="model_id" ref="model_hat_sentry_binance_collector"/>
        <field name="state">code</field>
        <field name="code">model.cron_collect_funding()</field>
        <field name="interval_number">60</field>
        <field name="interval_type">minutes</field>

        <field name="active" eval="False"/>

    </record>
</odoo>
