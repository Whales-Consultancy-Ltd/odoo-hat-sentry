<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hat_sentry_funding_event_tree" model="ir.ui.view">
        <field name="name">hat_sentry.funding.event.tree</field>
        <field name="model">hat_sentry.funding.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="symbol"/>
                <field name="funding_rate"/>
                <field name="funding_amount"/>
                <field name="funding_direction" decoration-success="funding_direction == 'received'" decoration-danger="funding_direction == 'paid'"/>
                <field name="event_datetime"/>
            </list>
        </field>
    </record>

    <record id="view_hat_sentry_funding_event_form" model="ir.ui.view">
        <field name="name">hat_sentry.funding.event.form</field>
        <field name="model">hat_sentry.funding.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="position_id"/>
                            <field name="symbol"/>
                            <field name="funding_rate"/>
                            <field name="funding_direction"/>
                        </group>
                        <group>
                            <field name="funding_amount"/>
                            <field name="event_datetime"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hat_sentry_funding_event_search" model="ir.ui.view">
        <field name="name">hat_sentry.funding.event.search</field>
        <field name="model">hat_sentry.funding.event</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_paid" string="Paid" domain="[('funding_direction', '=', 'paid')]"/>
                <filter name="filter_received" string="Received" domain="[('funding_direction', '=', 'received')]"/>
                <field name="symbol"/>
            </search>
        </field>
    </record>

    <record id="action_hat_sentry_funding_event" model="ir.actions.act_window">
        <field name="name">Funding Events</field>
        <field name="res_model">hat_sentry.funding.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Track funding rate events.</p>
        </field>
    </record>
</odoo>
