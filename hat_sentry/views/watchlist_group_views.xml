<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hat_sentry_watchlist_group_tree" model="ir.ui.view">
        <field name="name">hat_sentry.watchlist.group.tree</field>
        <field name="model">hat_sentry.watchlist.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hat_sentry_watchlist_group_form" model="ir.ui.view">
        <field name="name">hat_sentry.watchlist.group.form</field>
        <field name="model">hat_sentry.watchlist.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hat_sentry_watchlist_group" model="ir.actions.act_window">
        <field name="name">Watchlist Groups</field>
        <field name="res_model">hat_sentry.watchlist.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create watchlist groups to organize your assets
            </p>
            <p>
                <b>Examples:</b>
            </p>
            <ul>
                <li><b>Core Holdings</b> — Long-term positions (BTC, ETH)</li>
                <li><b>Trading</b> — Active trading positions</li>
                <li><b>Experimental</b> — High-risk assets</li>
                <li><b>Stable Reserve</b> — Stablecoins for liquidity</li>
            </ul>
            <p>
                After creating groups, assign assets to them in <i>Portfolio → Assets</i>
            </p>
        </field>
    </record>
</odoo>
