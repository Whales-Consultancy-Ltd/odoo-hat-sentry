<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hat_sentry_portfolio_snapshot_tree" model="ir.ui.view">
        <field name="name">hat_sentry.portfolio.snapshot.tree</field>
        <field name="model">hat_sentry.portfolio.snapshot</field>
        <field name="arch" type="xml">
            <list>
                <field name="snapshot_datetime"/>
                <field name="total_value"/>
                <field name="health_score" decoration-danger="health_score &lt; 40" decoration-warning="health_score &gt;= 40 and health_score &lt; 70" decoration-success="health_score &gt;= 70"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>

    <record id="view_hat_sentry_portfolio_snapshot_form" model="ir.ui.view">
        <field name="name">hat_sentry.portfolio.snapshot.form</field>
        <field name="model">hat_sentry.portfolio.snapshot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="snapshot_datetime"/>
                            <field name="total_value"/>
                            <field name="currency_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="health_score"/>
                            <field name="spot_value"/>
                            <field name="futures_margin_value"/>
                            <field name="futures_notional_value"/>
                        </group>
                    </group>
                    <group string="Breakdown by Bucket">
                        <field name="stablecoin_value"/>
                        <field name="core_value"/>
                        <field name="passive_income_value"/>
                        <field name="experimental_value"/>
                    </group>
                    <notebook>
                        <page string="Balances">
                            <field name="balance_ids"/>
                        </page>
                        <page string="Futures Positions">
                            <field name="futures_position_ids"/>
                        </page>
                        <page string="Earn Positions">
                            <field name="earn_position_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hat_sentry_portfolio_snapshot_graph" model="ir.ui.view">
        <field name="name">hat_sentry.portfolio.snapshot.graph</field>
        <field name="model">hat_sentry.portfolio.snapshot</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="snapshot_datetime" interval="day"/>
                <field name="total_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_hat_sentry_portfolio_snapshot_pivot" model="ir.ui.view">
        <field name="name">hat_sentry.portfolio.snapshot.pivot</field>
        <field name="model">hat_sentry.portfolio.snapshot</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="snapshot_datetime" interval="day" type="row"/>
                <field name="spot_value" type="measure"/>
                <field name="futures_margin_value" type="measure"/>
                <field name="stablecoin_value" type="measure"/>
                <field name="core_value" type="measure"/>
                <field name="passive_income_value" type="measure"/>
                <field name="experimental_value" type="measure"/>
                <field name="total_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hat_sentry_portfolio_snapshot_search" model="ir.ui.view">
        <field name="name">hat_sentry.portfolio.snapshot.search</field>
        <field name="model">hat_sentry.portfolio.snapshot</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_today" string="Today" date="snapshot_datetime"/>
                <separator/>
                <filter name="filter_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hat_sentry_portfolio_snapshot" model="ir.actions.act_window">
        <field name="name">Snapshots</field>
        <field name="res_model">hat_sentry.portfolio.snapshot</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p>View your portfolio snapshots.</p>
        </field>
    </record>
</odoo>
