<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_hat_sentry" model="ir.ui.view">
        <field name="name">res.config.settings.form.hat_sentry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Hat Sentry" string="Hat Sentry"
                     groups="hat_sentry.group_hat_sentry_manager">
                    <h2>Exchange API Keys</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="hat_sentry_binance_api_key"/>
                                <div class="text-muted">
                                    Enter your Binance API key for portfolio synchronization.
                                </div>
                                <field name="hat_sentry_binance_api_key" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="hat_sentry_binance_api_secret"/>
                                <div class="text-muted">
                                    Enter your Binance API secret for portfolio synchronization.
                                </div>
                                <field name="hat_sentry_binance_api_secret" password="True"/>
                            </div>
                        </div>
                    </div>
                    <h2>Telegram Notifications</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="hat_sentry_telegram_bot_token"/>
                                <div class="text-muted">
                                    Bot token from @BotFather for critical alert notifications.
                                </div>
                                <field name="hat_sentry_telegram_bot_token" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="hat_sentry_telegram_chat_id"/>
                                <div class="text-muted">
                                    Chat ID where notifications will be sent.
                                </div>
                                <field name="hat_sentry_telegram_chat_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
