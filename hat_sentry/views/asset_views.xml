<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hat_sentry_asset_tree" model="ir.ui.view">
        <field name="name">hat_sentry.asset.tree</field>
        <field name="model">hat_sentry.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="symbol"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="bucket"/>
                <field name="conviction" widget="badge"/>
                <field name="watchlist_status" widget="badge"/>
                <field name="review_date"/>
                <field name="review_overdue"/>
                <field name="is_stablecoin"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hat_sentry_asset_form" model="ir.ui.view">
        <field name="name">hat_sentry.asset.form</field>
        <field name="model">hat_sentry.asset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_hat_sentry_futures_position)d" type="action"
                                class="oe_stat_button" icon="fa-line-chart"
                                context="{'search_default_symbol': symbol}">
                            <div class="o_stat_info">
                                <field name="open_position_count" widget="statinfo"/>
                                <span class="o_stat_text">Positions</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="is_stablecoin"/>
                            <field name="is_core_asset"/>
                            <field name="currency_id" groups="hat_sentry.group_hat_sentry_manager"/>
                            <field name="active" groups="hat_sentry.group_hat_sentry_manager"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="watchlist" string="Watchlist">
                            <group>
                                <group>
                                    <field name="watchlist_group_id"/>
                                    <field name="conviction"/>
                                    <field name="watchlist_status"/>
                                    <field name="review_date"/>
                                    <field name="review_overdue"/>
                                </group>
                                <group>
                                    <field name="thesis"/>
                                    <field name="invalidation_level"/>
                                </group>
                            </group>
                            <group>
                                <field name="entry_price_target"/>
                                <field name="exit_price_target"/>
                                <field name="max_allocation_pct"/>
                            </group>
                            <field name="notes"/>
                            <div class="oe_button_box" name="review_buttons">
                                <button name="action_mark_reviewed" type="object"
                                        class="oe_stat_button" icon="fa-check">
                                    <div class="o_stat_info">
                                        <span class="o_stat_text">Mark Reviewed</span>
                                    </div>
                                </button>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hat_sentry_asset_search" model="ir.ui.view">
        <field name="name">hat_sentry.asset.search</field>
        <field name="model">hat_sentry.asset</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_crypto" string="Crypto" domain="[('asset_type', '=', 'crypto')]"/>
                <filter name="filter_stablecoin" string="Stablecoins" domain="[('asset_type', '=', 'stablecoin')]"/>
                <filter name="filter_fiat" string="Fiat" domain="[('asset_type', '=', 'fiat')]"/>
                <separator/>
                <filter name="filter_core" string="Core" domain="[('bucket', '=', 'core')]"/>
                <filter name="filter_stable_reserve" string="Stable Reserve" domain="[('bucket', '=', 'stable_reserve')]"/>
                <filter name="filter_passive_income" string="Passive Income" domain="[('bucket', '=', 'passive_income')]"/>
                <filter name="filter_trading" string="Trading" domain="[('bucket', '=', 'trading')]"/>
                <filter name="filter_futures" string="Futures" domain="[('bucket', '=', 'futures')]"/>
                <filter name="filter_experimental" string="Experimental" domain="[('bucket', '=', 'experimental')]"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_active_watchlist" string="Active Watchlist"
                        domain="[('watchlist_status', 'in', ['active', 'watching'])]"/>
                <filter name="filter_overdue_review" string="Overdue Review"
                        domain="[('review_overdue', '=', True)]"/>
                <filter name="filter_conviction_high" string="High Conviction"
                        domain="[('conviction', '=', 'high')]"/>
                <separator/>
                <filter name="group_watchlist_group" string="Watchlist Group"
                        context="{'group_by': 'watchlist_group_id'}"/>
                <filter name="group_conviction" string="Conviction"
                        context="{'group_by': 'conviction'}"/>
                <filter name="group_watchlist_status" string="Status"
                        context="{'group_by': 'watchlist_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_hat_sentry_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">hat_sentry.asset</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Configure your crypto assets here.</p>
        </field>
    </record>
</odoo>
