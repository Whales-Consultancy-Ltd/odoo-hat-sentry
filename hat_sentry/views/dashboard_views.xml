<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View definition for the dashboard board — board.board is AbstractModel in Odoo 19 (no data record needed) -->
    <record id="board_hat_sentry_dashboard_form" model="ir.ui.view">
        <field name="name">hat_sentry.dashboard.form</field>
        <field name="model">board.board</field>
        <field name="arch" type="xml">
            <form string="Hat Sentry Dashboard">
                <board style="2-2-1">
                    <column>
                        <action name="%(action_hat_sentry_portfolio_snapshot)d" string="Portfolio Evolution" view_mode="graph"/>
                        <action name="%(action_hat_sentry_portfolio_snapshot)d" string="Asset Allocation" view_mode="graph" context="{'search_default_allocation_pie': 1}" search_view_id="%(view_hat_sentry_portfolio_snapshot_allocation_graph)d"/>
                    </column>
                    <column>
                        <action name="%(action_hat_sentry_portfolio_snapshot)d" string="P&amp;L Evolution" view_mode="graph" context="{'search_default_pnl_view': 1}" search_view_id="%(view_hat_sentry_portfolio_snapshot_pnl_graph)d"/>
                        <action name="%(action_hat_sentry_futures_position)d" string="Futures Exposure" view_mode="graph" context="{'search_default_filter_open': 1}" search_view_id="%(view_hat_sentry_futures_exposure_graph)d"/>
                    </column>
                    <column>
                        <action name="%(action_hat_sentry_portfolio_snapshot)d" string="Health Score" view_mode="graph" context="{'search_default_health_view': 1}" search_view_id="%(view_hat_sentry_portfolio_snapshot_health_graph)d"/>
                        <action name="%(action_hat_sentry_balance)d" string="Balances" view_mode="list"/>
                    </column>
                </board>
            </form>
        </field>
    </record>

    <record id="action_hat_sentry_dashboard" model="ir.actions.act_window">
        <field name="name">Portfolio Overview</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="board_hat_sentry_dashboard_form"/>
        <field name="target">main</field>
    </record>
</odoo>
