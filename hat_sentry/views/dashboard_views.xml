<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View definition for the dashboard board -->
    <record id="board_hat_sentry_dashboard_form" model="ir.ui.view">
        <field name="name">hat_sentry.dashboard.form</field>
        <field name="model">board.board</field>
        <field name="arch" type="xml">
            <form string="Hat Sentry Dashboard">
                <board style="2-2-1">
                    <column>
                        <action name="%(action_hat_sentry_portfolio_snapshot)d" string="Portfolio Over Time" view_mode="graph"/>
                        <action name="%(action_hat_sentry_portfolio_snapshot)d" string="Portfolio Breakdown" view_mode="pivot"/>
                    </column>
                    <column>
                        <action name="%(action_hat_sentry_futures_position)d" string="Open Positions" view_mode="kanban" context="{'search_default_filter_open': 1}"/>
                        <action name="%(action_hat_sentry_alert)d" string="Active Alerts" view_mode="kanban" domain="[('state', 'in', ('new','sent','acknowledged'))]"/>
                    </column>
                    <column>
                        <action name="%(action_hat_sentry_balance)d" string="Balances" view_mode="list"/>
                        <action name="%(action_hat_sentry_earn_position)d" string="Earn Positions" view_mode="list"/>
                    </column>
                </board>
            </form>
        </field>
    </record>

    <record id="action_hat_sentry_dashboard" model="ir.actions.act_window">
        <field name="name">Portfolio Overview</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="board_hat_sentry_dashboard_form"/>
        <field name="target">inline</field>
    </record>
</odoo>
