<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hat_sentry_credential_tree" model="ir.ui.view">
        <field name="name">hat_sentry.credential.tree</field>
        <field name="model">hat_sentry.credential</field>
        <field name="arch" type="xml">
            <list>
                <field name="exchange"/>
                <field name="api_key" password="True"/>
                <field name="permissions"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hat_sentry_credential_form" model="ir.ui.view">
        <field name="name">hat_sentry.credential.form</field>
        <field name="model">hat_sentry.credential</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="exchange"/>
                            <field name="environment"/>
                            <field name="api_key" password="True"/>
                            <field name="api_secret" password="True"
                                   groups="hat_sentry.group_hat_sentry_manager"/>
                            <field name="permissions"/>
                        </group>
                        <group>
                            <field name="last_validation_status"/>
                            <field name="last_validation_at"/>
                            <field name="last_validation_message"/>
                            <field name="last_successful_sync_at"/>
                            <field name="ip_whitelist"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="view_hat_sentry_credential_search" model="ir.ui.view">
        <field name="name">hat_sentry.credential.search</field>
        <field name="model">hat_sentry.credential</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_binance" string="Binance" domain="[('exchange', '=', 'binance')]"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hat_sentry_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">hat_sentry.credential</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Configure your exchange API credentials here. Only read-only keys are allowed.</p>
        </field>
    </record>
</odoo>
