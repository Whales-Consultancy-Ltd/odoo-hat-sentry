<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hat_sentry_setup_wizard_form" model="ir.ui.view">
        <field name="name">hat_sentry.setup.wizard.form</field>
        <field name="model">hat_sentry.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Hat Sentry Setup">
                <group>
                    <field name="company_id"/>
                    <field name="exchange"/>
                    <field name="api_key"/>
                    <field name="api_secret"/>
                </group>
                <group invisible="not test_result">
                    <field name="test_result" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                    <button name="action_save" type="object" string="Save" class="oe_highlight" invisible="not test_success"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hat_sentry_setup_wizard" model="ir.actions.act_window">
        <field name="name">Setup Hat Sentry</field>
        <field name="res_model">hat_sentry.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
