<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hat_sentry_asset_company" model="ir.rule">
        <field name="name">hat_sentry.asset: multi-company isolation</field>
        <field name="model_id" ref="model_hat_sentry_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rule_hat_sentry_portfolio_snapshot_company" model="ir.rule">
        <field name="name">hat_sentry.portfolio.snapshot: multi-company isolation</field>
        <field name="model_id" ref="model_hat_sentry_portfolio_snapshot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
