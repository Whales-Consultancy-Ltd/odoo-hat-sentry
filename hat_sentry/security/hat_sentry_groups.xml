<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_hat_sentry">
        <field name="name">Hat Sentry</field>
        <field name="sequence">1</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_hat_sentry">
        <field name="name">Hat Sentry</field>
        <field name="category_id" ref="module_category_hat_sentry"/>
    </record>

    <!-- User: read-only -->
    <record id="group_hat_sentry_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_hat_sentry"/>
    </record>

    <!-- Trader: implies User -->
    <record id="group_hat_sentry_trader" model="res.groups">
        <field name="name">Trader</field>
        <field name="implied_ids" eval="[(4, ref('group_hat_sentry_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_hat_sentry"/>
    </record>

    <!-- Manager: implies Trader (which implies User) -->
    <record id="group_hat_sentry_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_hat_sentry_trader'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_hat_sentry"/>
    </record>
</odoo>
