<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hat_sentry_journal_tag_tree" model="ir.ui.view">
        <field name="name">hat_sentry.journal.tag.tree</field>
        <field name="model">hat_sentry.journal.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hat_sentry_journal_tag_form" model="ir.ui.view">
        <field name="name">hat_sentry.journal.tag.form</field>
        <field name="model">hat_sentry.journal.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hat_sentry_journal_tag" model="ir.actions.act_window">
        <field name="name">Journal Tags</field>
        <field name="res_model">hat_sentry.journal.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Define tags to categorize your decision logs.</p>
        </field>
    </record>
</odoo>
